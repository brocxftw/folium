# Folium configuration — copy to .env and adjust before first run
#   cp .env.example .env
#
# Generate strong secrets, for example:
#   openssl rand -hex 32

# Application
FOLIUM_SECRET_KEY=change-me-to-a-long-random-string
FOLIUM_ENCRYPTION_KEY=change-me-to-another-long-random-string
FOLIUM_ENV=production
FOLIUM_LOG_LEVEL=INFO
FOLIUM_HOST=0.0.0.0
FOLIUM_PORT=8000

# Bootstrap admin — used ONLY on first start when the users table is empty.
# Changing these later does NOT update existing accounts or passwords.
# After first boot, change passwords in the UI (Profile / Users → Set password)
# or recover with: docker compose exec api folium reset-admin-password
FOLIUM_ADMIN_USERNAME=admin
FOLIUM_ADMIN_PASSWORD=changeme

# Multi-user auth
ALLOW_REGISTRATION=true
# DEFAULT_STORAGE_QUOTA_BYTES=
# DEFAULT_AI_MONTHLY_REQUEST_QUOTA=
# Password reset links (after admin approval) expire after this many hours
PASSWORD_RESET_TOKEN_TTL_HOURS=1
MAX_AVATAR_SIZE_MB=2
# Optional: username that owns files dropped into the consume folder
# (default: earliest active admin)
# CONSUME_OWNER_USERNAME=
# Database (Compose service hostname is "db")
DATABASE_URL=postgresql+asyncpg://folium:folium@db:5432/folium
DATABASE_URL_SYNC=postgresql+psycopg://folium:folium@db:5432/folium

# In-container storage paths (must match compose volume targets)
DOCUMENTS_PATH=/documents
CONSUME_PATH=/consume
EXPORT_PATH=/export

# Optional: override host bind sources for documents/consume/export
# Defaults in docker-compose are ./data/documents, ./data/consume, ./data/export
# FOLIUM_DOCUMENTS_HOST=./data/documents
# Optional display metadata for the Settings > System page. This is not inferred
# from the container mount and may be a relative configured source.
# FOLIUM_DOCUMENTS_HOST_SOURCE=./data/documents
# FOLIUM_CONSUME_HOST=./data/consume
# FOLIUM_EXPORT_HOST=./data/export

# Upload limits
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# OCR (PaddleOCR PP-OCRv6 small, CPU). Folium/legacy codes: eng, chi_sim, rus, ara, …
OCR_LANGUAGE=eng
OCR_ENABLED=true
# FOLIUM_PADDLE_CACHE_HOST=./data/paddleocr

# Jobs / trash
JOB_CONCURRENCY=2
CONSUME_POLL_INTERVAL_SECONDS=5
JOB_POLL_INTERVAL_SECONDS=2
TRASH_RETENTION_DAYS=30
TRASH_PURGE_INTERVAL_SECONDS=3600
APPLICATION_LOG_RETENTION_DAYS=30

# AI defaults (optional — Folium works without AI)
AI_PRIVACY_MODE=local_only
AI_PROFILE=lightweight
AI_ALLOW_REMOTE_EMBEDDINGS=false
AI_ALLOW_REMOTE_QA=false
AI_ALLOW_REMOTE_VISION=false
AI_WARN_BEFORE_REMOTE=true

# Session
SESSION_COOKIE_NAME=folium_session
SESSION_TTL_HOURS=168
CSRF_COOKIE_NAME=folium_csrf

# Frontend origin (CSRF / CORS). Use your public URL in production.
FRONTEND_ORIGIN=http://localhost:8080

# Optional authoritative About/build metadata. Omit links that are not canonical.
# FOLIUM_BUILD_REVISION=
# FOLIUM_BUILD_DATE=
# FOLIUM_REPOSITORY_URL=
# FOLIUM_ISSUES_URL=
# FOLIUM_DOCS_URL=
# FOLIUM_RELEASES_URL=
# FOLIUM_LICENSE_URL=
