FROM python:3.13-slim-bookworm

ARG FOLIUM_VERSION=0.0.0-dev
ARG FOLIUM_BUILD_REVISION=
ARG FOLIUM_BUILD_DATE=
ARG FOLIUM_SOURCE=https://github.com/brocxftw/folium

LABEL org.opencontainers.image.title="Folium backend" \
      org.opencontainers.image.description="Folium API, worker, OCR, indexing, and database migrations" \
      org.opencontainers.image.source="${FOLIUM_SOURCE}" \
      org.opencontainers.image.url="${FOLIUM_SOURCE}" \
      org.opencontainers.image.documentation="${FOLIUM_SOURCE}/blob/main/docs/deployment/install.md" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.version="${FOLIUM_VERSION}" \
      org.opencontainers.image.revision="${FOLIUM_BUILD_REVISION}" \
      org.opencontainers.image.created="${FOLIUM_BUILD_DATE}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_SYSTEM_PYTHON=1 \
    PADDLE_PDX_CACHE_HOME=/app/.paddleocr \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0 \
    FLAGS_use_mkldnn=0 \
    FOLIUM_VERSION=${FOLIUM_VERSION} \
    FOLIUM_BUILD_REVISION=${FOLIUM_BUILD_REVISION} \
    FOLIUM_BUILD_DATE=${FOLIUM_BUILD_DATE} \
    FOLIUM_REPOSITORY_URL=${FOLIUM_SOURCE} \
    FOLIUM_ISSUES_URL=${FOLIUM_SOURCE}/issues \
    FOLIUM_DOCS_URL=${FOLIUM_SOURCE}/blob/main/docs/README.md \
    FOLIUM_RELEASES_URL=${FOLIUM_SOURCE}/releases \
    FOLIUM_LICENSE_URL=${FOLIUM_SOURCE}/blob/main/LICENSE

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libmagic1 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libgfortran5 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 folium && useradd -u 1000 -g folium -m -s /bin/bash folium \
    && mkdir -p /documents /consume /export /app /app/.paddleocr \
    && chown -R folium:folium /documents /consume /export /app

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv

WORKDIR /app
COPY backend/pyproject.toml backend/README.md /app/
COPY backend/src /app/src
COPY backend/alembic /app/alembic
COPY backend/alembic.ini /app/alembic.ini

# PaddlePaddle CPU wheels are published on the official index (not always on PyPI).
# --no-cache avoids filling the layer with huge wheel extract temps.
RUN uv pip install --system --no-cache \
        paddlepaddle==3.3.0 \
        -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && uv pip install --system --no-cache -e ".[ocr]" \
    && chown -R folium:folium /app

COPY docker/backend-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh \
    && chown folium:folium /app/entrypoint.sh

USER folium

EXPOSE 8000

ENTRYPOINT ["/bin/bash", "/app/entrypoint.sh"]
CMD ["folium-api"]
